<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TradeTracesNTStub.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Consumes the TestKit exactly as the journey tests will. -->
    <ProjectReference Include="..\..\src\Api.TradeTracesNTStub.TestKit\Api.TradeTracesNTStub.TestKit.csproj" />
    <!-- The package carries the simulator's dll for its control models, but a project reference
         doesn't flow it on, so it's referenced directly here. -->
    <ProjectReference Include="..\..\src\Api.TradeTracesNTStub.Simulator\Api.TradeTracesNTStub.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoreWCF 1.9.1, through the simulator, brings in 10.0.10, which has published advisories
         (CVE-2026-84008 and others). Projects on the ASP.NET framework get the patched one from it;
         this one isn't. Drop once a CoreWCF release references a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Defra.Trade.Gateway.TracesNT" Version="0.1.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Verify.XunitV3" Version="31.14.0" />
    <PackageReference Include="WireMock.Net.RestClient" Version="1.25.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
