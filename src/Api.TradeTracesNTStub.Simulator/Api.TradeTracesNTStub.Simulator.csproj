<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code lists and registries the control API derives display values from. -->
    <EmbeddedResource Include="Control\Lookups\SeedData\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The TRACES contracts and ports, generated from master.wsdl in the gateway repo.
         Sharing the package is what stops the simulator and the gateway's clients drifting. -->
    <PackageReference Include="Defra.Trade.Gateway.TracesNT" Version="0.1.0" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <!-- CoreWCF 1.9.1 brings in 10.0.10, which has published advisories (CVE-2026-84008 and others).
         Drop this once a CoreWCF release references a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
